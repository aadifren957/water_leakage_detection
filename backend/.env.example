# WaterWatch Backend Environment Variables
PORT=5001
NODE_ENV=development

# Supabase PostgreSQL Connection URL
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@[YOUR-PROJECT-REF].supabase.co:5432/postgres?sslmode=require"

# JWT Authentication
JWT_SECRET="YOUR_LONG_RANDOM_SECURE_JWT_SECRET_KEY_AT_LEAST_32_CHARS"
JWT_EXPIRES_IN="7d"

# CORS Configuration
CORS_ORIGIN="*"

# IoT Ingestion Security (For ESP8266 devices)
IOT_API_KEY="waterwatch_iot_secure_ingest_key_change_in_prod"

# Email Delivery Provider (Choose 'resend', 'smtp', or 'console' for local testing)
EMAIL_PROVIDER="console" # 'resend' | 'smtp' | 'console'
EMAIL_FROM="WaterWatch Support <onboarding@resend.dev>"

# Resend Configuration (If EMAIL_PROVIDER=resend)
RESEND_API_KEY="re_123456789_abcdefg"

# SMTP Configuration (If EMAIL_PROVIDER=smtp, e.g. Gmail / Brevo / SendGrid / SES)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
SMTP_SECURE=false

# OTP Configuration
OTP_EXPIRY_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5

# Initial Municipal Officer Account Setup
INITIAL_OFFICER_NAME="Rajesh Varma"
INITIAL_OFFICER_EMAIL="officer@demo.com"
INITIAL_OFFICER_PASSWORD="Officer@123"
INITIAL_OFFICER_DEPARTMENT="Municipal Water Supply & Sewerage Board"
INITIAL_OFFICER_PHONE="+91 98765 43210"
INITIAL_OFFICER_ZONE="Central City Zone"
